      <div class="bill-line"><span>ค่าไฟ</span><span>฿${fmtMoney(elec)}</span></div>
      <div class="bill-line"><span>ค่าใช้จ่ายอื่นๆ</span><span>฿${fmtMoney(feesTotal)}</span></div>
      <div class="bill-line total"><span>รวมทั้งสิ้น</span><span>฿${fmtMoney(total)}</span></div>
    </div>

    <div class="checkbox-row">
      <input type="checkbox" id="bPaid" ${bill.paid?'checked':''}>
