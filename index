      <div class="field"><label>วันที่เริ่มสัญญา</label><input id="fStart" type="date" value="${rec.contractStart}"></div>
      <div class="field"><label>วันที่ครบกำหนดสัญญา</label><input id="fEnd" type="date" value="${rec.contractEnd}"></div>
    </div>
    <div class="hint">ระบบต่อสัญญาใหม่ทุก ${RENEW_MONTHS} เดือน — กด "ต่อสัญญาใหม่" เพื่อคำนวณวันครบกำหนดถัดไปให้อัตโนมัติ ${statusLine}</div>
