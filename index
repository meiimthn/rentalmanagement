    <div class="field-row">
      <div class="field"><label>จำนวนผู้พัก (หัวละ ฿${WATER_RATE})</label><input id="bHeads" type="number" min="0" value="${bill.heads}"></div>
      <div class="field"><label>หน่วยไฟที่ใช้ (หน่วยละ ฿${ELEC_RATE})</label><input id="bElec" type="number" min="0" value="${bill.elecUnits}"></div>
    </div>
    <label style="font-size:12.5px;color:#6b6154;font-weight:500;">ค่าปรับ / ค่าใช้จ่ายอื่นๆ</label>
    <div id="feeList">
      ${(bill.otherFees||[]).map((f,i)=>`
        <div class="fee-item" data-idx="${i}">
          <input class="fdesc" placeholder="รายการ เช่น ค่าปรับจอดรถ" value="${escapeHtml(f.desc)}">
          <input class="famt" type="number" placeholder="บาท" value="${Number(f.amt)||0}">
          <button data-rmfee="${i}">✕</button>
        </div>`).join('')}
    </div>
    <button class="add-fee" id="addFee">+ เพิ่มรายการค่าใช้จ่ายอื่น</button>

    <div class="bill-summary">
      <div class="bill-line"><span>ค่าเช่าห้อง</span><span>฿${fmtMoney(rent)}</span></div>
