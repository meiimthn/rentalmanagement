<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ระบบจัดการห้องเช่า</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Thai:wght@500;600;700&family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1B2B20;
    --paper:#F4EFE1;
    --paper-dim:#EAE2CC;
    --brass:#A9822F;
    --brass-dim:#C7A557;
    --moss:#4C6B4F;
    --moss-dim:#7C9A7E;
    --clay:#AF4F2C;
    --clay-bg:#F6E3D8;
    --line:#D8CFB8;
    --white:#FFFDF7;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans Thai',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.serif{ font-family:'Noto Serif Thai',serif; }
  button{ font-family:inherit; cursor:pointer; }
  input,select,textarea{ font-family:inherit; }

  /* ---------- Header ---------- */
  .topbar{
    background:var(--ink);
    color:var(--paper);
    padding:22px 28px 18px;
    position:sticky; top:0; z-index:30;
    border-bottom:3px solid var(--brass);
  }
  .topbar-inner{
    max-width:1180px; margin:0 auto;
    display:flex; align-items:flex-end; justify-content:space-between; flex-wrap:wrap; gap:14px;
  }
  .brand{ display:flex; align-items:center; gap:12px; }
  .brand-mark{
    width:38px;height:38px; flex:none;
    background:var(--brass);
    -webkit-mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 2 3 9v13h6v-7h6v7h6V9z'/></svg>") no-repeat center / contain;
    mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 2 3 9v13h6v-7h6v7h6V9z'/></svg>") no-repeat center / contain;
  }
  .brand h1{ font-size:22px; margin:0; letter-spacing:.2px; }
  .brand p{ margin:2px 0 0; font-size:12.5px; color:var(--paper-dim); opacity:.8; }
  .tabs{ display:flex; gap:4px; }
  .tab-btn{
    background:none; border:none; color:var(--paper-dim);
    padding:9px 16px; border-radius:7px 7px 0 0; font-size:14.5px; font-weight:500;
    border-bottom:2px solid transparent;
  }
  .tab-btn.active{ color:var(--white); border-bottom:2px solid var(--brass); background:rgba(255,255,255,.06); }
  .tab-btn:hover{ color:var(--white); }

  /* ---------- Layout ---------- */
  .wrap{ max-width:1180px; margin:0 auto; padding:26px 28px 80px; }
  .section-title{ font-size:19px; margin:0 0 4px; }
  .section-sub{ margin:0 0 18px; color:var(--moss); font-size:13.5px; }

  /* ---------- Month picker ---------- */
  .month-picker{
    display:inline-flex; align-items:center; gap:10px;
    background:var(--white); border:1px solid var(--line); border-radius:10px;
    padding:7px 8px; margin-bottom:22px;
  }
  .month-picker button{
    width:28px;height:28px; border-radius:6px; border:1px solid var(--line); background:var(--paper);
    font-size:15px; color:var(--ink);
  }
  .month-picker button:hover{ background:var(--paper-dim); }
  .month-picker .m-label{ font-weight:600; font-size:14.5px; min-width:118px; text-align:center; }

  /* ---------- Stat cards ---------- */
  .stat-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:14px; margin-bottom:26px; }
  .stat-card{ background:var(--white); border:1px solid var(--line); border-radius:12px; padding:16px 18px; }
  .stat-card .num{ font-family:'Noto Serif Thai',serif; font-size:28px; font-weight:600; line-height:1; }
  .stat-card .lbl{ font-size:12.5px; color:#6b6154; margin-top:6px; }
  .stat-card.accent{ border-color:var(--brass); }
  .stat-card.warn .num{ color:var(--clay); }

  /* ---------- Alerts ---------- */
  .alert-list{ display:flex; flex-direction:column; gap:8px; margin-bottom:30px; }
  .alert-item{
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    background:var(--clay-bg); border:1px solid #e3bfa8; border-radius:10px; padding:11px 15px; font-size:13.8px;
  }
  .alert-item.soft{ background:#FBF3D9; border-color:#e8d69a; }
  .alert-item b{ font-weight:600; }
  .alert-item button{
    border:none; background:var(--ink); color:var(--white); padding:6px 12px; border-radius:7px; font-size:12.5px;
  }
  .empty-note{ color:#8a806f; font-size:13.5px; padding:10px 2px 26px; }

  /* ---------- Rooms filter ---------- */
  .filter-row{ display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px; }
  .filter-row .fbtn{
    border:1px solid var(--line); background:var(--white); border-radius:20px; padding:6px 14px; font-size:13px;
  }
  .filter-row .fbtn.active{ background:var(--ink); color:var(--white); border-color:var(--ink); }
  .searchbox{
    border:1px solid var(--line); border-radius:20px; padding:6px 14px; font-size:13px; min-width:180px; background:var(--white);
  }

  /* ---------- Building groups / room grid ---------- */
  .building-block{ margin-bottom:28px; }
  .building-head{ display:flex; align-items:baseline; gap:10px; margin-bottom:10px; }
  .building-head h3{ font-size:15.5px; margin:0; }
  .building-head span{ font-size:12px; color:#8a806f; }
  .room-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(198px,1fr)); gap:12px; }
  .room-card{
    background:var(--white); border:1px solid var(--line); border-left:4px solid var(--moss);
    border-radius:10px; padding:13px 14px; cursor:pointer; transition:box-shadow .15s, transform .15s;
  }
  .room-card:hover{ box-shadow:0 4px 14px rgba(27,43,32,.1); transform:translateY(-1px); }
  .room-card.vacant{ border-left-color:#b9ae8f; }
  .room-card .rid{ font-family:'Noto Serif Thai',serif; font-size:19px; font-weight:600; }
  .room-card .price{ font-size:12.5px; color:var(--brass); font-weight:600; margin-top:1px;}
  .room-card .tenant{ font-size:13px; margin-top:8px; color:var(--ink); }
  .room-card .tenant.muted{ color:#a89d85; font-style:italic; }
  .badge{ display:inline-block; font-size:11px; padding:2px 8px; border-radius:10px; font-weight:600; margin-top:8px; margin-right:4px;}
  .badge.paid{ background:#dfeadf; color:var(--moss); }
  .badge.unpaid{ background:var(--clay-bg); color:var(--clay); }
  .badge.exp-soon{ background:#FBF3D9; color:#9c7a0f; }
  .badge.exp-over{ background:var(--clay-bg); color:var(--clay); }
  .badge.ac{ background:#e6edf5; color:#3b5a86; }

  /* ---------- Modal ---------- */
  .overlay{ position:fixed; inset:0; background:rgba(20,26,17,.55); display:none; align-items:flex-start; justify-content:center; padding:34px 16px; overflow:auto; z-index:50;}
  .overlay.show{ display:flex; }
  .modal{ background:var(--paper); border-radius:14px; max-width:640px; width:100%; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,.35); }
  .modal-head{ background:var(--ink); color:var(--white); padding:18px 22px; display:flex; justify-content:space-between; align-items:center; }
  .modal-head h2{ margin:0; font-size:20px; }
  .modal-head .sub{ font-size:12px; color:var(--paper-dim); opacity:.85; margin-top:2px;}
  .modal-head button{ background:none; border:none; color:var(--paper-dim); font-size:20px; }
  .modal-tabs{ display:flex; border-bottom:1px solid var(--line); background:var(--white); }
  .modal-tabs button{ flex:1; border:none; background:none; padding:11px 8px; font-size:13.2px; font-weight:500; color:#847a67; border-bottom:2px solid transparent; }
  .modal-tabs button.active{ color:var(--ink); border-bottom:2px solid var(--brass); background:var(--paper); }
  .modal-body{ padding:20px 22px 26px; max-height:64vh; overflow:auto; }
  .field-row{ display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px; }
  .field{ display:flex; flex-direction:column; gap:4px; }
  .field label{ font-size:12.5px; color:#6b6154; font-weight:500; }
  .field input, .field select{ border:1px solid var(--line); border-radius:8px; padding:8px 10px; font-size:14px; background:var(--white); color:var(--ink); }
  .field.full{ grid-column:1/-1; }
  .btn{ border:none; border-radius:8px; padding:9px 16px; font-size:13.5px; font-weight:600; }
  .btn-primary{ background:var(--ink); color:var(--white); }
  .btn-primary:hover{ background:#0f1a10; }
  .btn-ghost{ background:var(--white); border:1px solid var(--line); color:var(--ink); }
  .btn-danger{ background:var(--clay-bg); color:var(--clay); border:1px solid #e3bfa8; }
  .btn-row{ display:flex; gap:8px; margin-top:8px; flex-wrap:wrap; }
  .divider{ border:none; border-top:1px solid var(--line); margin:18px 0; }
  .hint{ font-size:12px; color:#8a806f; margin:-6px 0 10px; }

  .bill-summary{ background:var(--white); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-top:12px;}
  .bill-line{ display:flex; justify-content:space-between; font-size:13.5px; padding:4px 0; }
  .bill-line.total{ border-top:1px solid var(--line); margin-top:6px; padding-top:8px; font-weight:700; font-size:15.5px; }
  .fee-item{ display:flex; gap:8px; align-items:center; margin-bottom:6px; }
  .fee-item input{ border:1px solid var(--line); border-radius:7px; padding:6px 8px; font-size:13px; }
  .fee-item .fdesc{ flex:1; }
  .fee-item .famt{ width:90px; }
  .fee-item button{ background:none; border:none; color:var(--clay); font-size:16px; padding:0 4px; }
  .add-fee{ background:none; border:1px dashed var(--line); border-radius:7px; padding:6px 10px; font-size:12.5px; color:var(--moss); width:100%; margin-top:2px;}

  .month-table{ width:100%; border-collapse:collapse; font-size:13px; margin-top:6px;}
  .month-table th{ text-align:left; color:#8a806f; font-weight:600; font-size:11.5px; padding:6px 8px; border-bottom:1px solid var(--line); }
  .month-table td{ padding:7px 8px; border-bottom:1px solid var(--line); }
  .month-table tr:hover td{ background:var(--white); }
  .link-btn{ background:none;border:none;color:var(--moss);font-weight:600;font-size:12.5px; }

  .maint-item{ background:var(--white); border:1px solid var(--line); border-radius:9px; padding:10px 13px; margin-bottom:8px; }
  .maint-item .d{ font-size:11.5px; color:#8a806f; }
  .maint-item .c{ font-size:13.5px; margin-top:2px; }
  .maint-item .cost{ font-size:12px; color:var(--brass); font-weight:600; margin-top:2px;}

  .checkbox-row{ display:flex; align-items:center; gap:8px; margin:10px 0; }
  .checkbox-row input{ width:17px;height:17px; }

  .loading{ padding:80px 20px; text-align:center; color:#8a806f; font-size:14px;}

  .banner-msg{
    max-width:1180px; margin:0 auto; background:#FBF3D9; border-bottom:1px solid #e8d69a;
    color:#6b5410; font-size:13px; padding:9px 28px; text-align:center;
  }
  .banner-msg.error{ background:var(--clay-bg); border-bottom-color:#e3bfa8; color:var(--clay); }
  .toast{
    position:fixed; bottom:20px; left:50%; transform:translateX(-50%);
    background:var(--ink); color:var(--white); padding:10px 18px; border-radius:8px; font-size:13px; z-index:80;
    opacity:0; transition:opacity .25s;
  }
  .toast.show{ opacity:1; }

  @media (max-width:600px){
    .field-row{ grid-template-columns:1fr; }
    .topbar-inner{ flex-direction:column; align-items:flex-start; }
  }
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <div class="brand-mark"></div>
      <div>
        <h1>ระบบจัดการห้องเช่า</h1>
        <p>ดูแลห้องพัก 29 ห้อง · บิล · สัญญา · งานซ่อม · ข้อมูลแชร์ร่วมกันทั้งทีม</p>
      </div>
    </div>
    <div class="tabs" style="align-items:center;">
      <button class="tab-btn active" data-view="dashboard">ภาพรวม</button>
      <button class="tab-btn" data-view="rooms">ห้องพักทั้งหมด</button>
      <button id="refreshBtn" class="tab-btn" title="ดึงข้อมูลล่าสุดจากทีม">↻ รีเฟรช</button>
      <button id="backupBtn" class="tab-btn" title="สำรองข้อมูลทั้งหมดเป็นไฟล์">⭳ สำรองข้อมูล</button>
      <button id="restoreBtn" class="tab-btn" title="กู้คืนข้อมูลจากไฟล์สำรอง">⭱ กู้คืน</button>
      <input type="file" id="restoreFile" accept="application/json" style="display:none;">
    </div>
  </div>
</div>

<div id="banner"></div>

<div class="wrap" id="app">
  <div class="loading">กำลังโหลดข้อมูลห้องพัก…</div>
</div>

<div class="overlay" id="overlay">
  <div class="modal" id="modalBox"></div>
</div>

<script>
/* ============================= DATA MODEL ============================= */
const ROOMS = [
  {id:'G1', building:'อาคาร A · ริมสวน', price:4000, rentable:true},
  {id:'G2', building:'อาคาร A · ริมสวน', price:8000, rentable:true},
  {id:'G3', building:'อาคาร A · ริมสวน', price:0,    rentable:false},

  {id:'1/1', building:'อาคาร B', price:1300},
  {id:'1/2', building:'อาคาร B', price:1300},
  {id:'1/3', building:'อาคาร B', price:1500},
  {id:'1/4', building:'อาคาร B', price:1500},
  {id:'1/5', building:'อาคาร B', price:1500},

  {id:'2/1', building:'อาคาร C', price:1300},
  {id:'2/2', building:'อาคาร C', price:1300},
  {id:'2/3', building:'อาคาร C', price:1300},
  {id:'2/4', building:'อาคาร C', price:1300},
  {id:'2/5', building:'อาคาร C', price:2600, ac:true},
  {id:'2/6', building:'อาคาร C', price:1500},
  {id:'2/7', building:'อาคาร C', price:1500},
  {id:'2/8', building:'อาคาร C', price:1500},
  {id:'2/9', building:'อาคาร C', price:1500},

  {id:'3/1', building:'อาคาร D', price:1300},
  {id:'3/2', building:'อาคาร D', price:1300},
  {id:'3/3', building:'อาคาร D', price:1300},
  {id:'3/4', building:'อาคาร D', price:1300},
  {id:'3/5', building:'อาคาร D', price:1500},
  {id:'3/6', building:'อาคาร D', price:1500},
  {id:'3/7', building:'อาคาร D', price:1500},
  {id:'3/8', building:'อาคาร D', price:1500},
  {id:'3/9', building:'อาคาร D', price:1500},

  {id:'4/1', building:'อาคาร E', price:1300},
  {id:'4/2', building:'อาคาร E', price:1900, ac:true},
  {id:'4/3', building:'อาคาร E', price:1500},
];
ROOMS.forEach(r=>{ if(r.rentable===undefined) r.rentable=true; });

const WATER_RATE = 100;   // บาท/หัว
const ELEC_RATE  = 7;     // บาท/หน่วย
const RENEW_MONTHS = 4;

const THAI_MONTHS = ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];

let roomData = {};        // id -> stored record
let viewMonth = new Date(); viewMonth.setDate(1);
let currentView = 'dashboard';
let roomFilter = 'all';
let searchTerm = '';
let modalRoomId = null;
let modalTab = 'tenant';

/* ============================= STORAGE HELPERS ============================= */
function defaultRoomRecord(base){
  return {
    price: base.price,
    tenantName:'', phone:'',
    contractStart:'', contractEnd:'',
    defaultHeads: 1,
    bills:{},        // monthKey -> {heads, elecUnits, otherFees:[{desc,amt}], paid, paidDate}
    maintenance:[]   // {date, desc, cost}
  };
}

/* ============================= GOOGLE SHEETS BACKEND CONFIG =============================
   หลังจาก deploy Google Apps Script แล้ว ให้นำ URL และรหัสลับ (SECRET) มาใส่ 2 บรรทัดนี้
   (หรือส่งมาให้ Claude แล้วให้ช่วยใส่ให้ก็ได้)                                            */
const SHEET_API_URL   = "https://script.google.com/macros/s/AKfycbzOjKHALdbioZbqJ5swJvTQw0--s7KgZ_cnkzksqBgKtnMzgNljNQ3hsb_K_3uSwQW-/exec";
const SHEET_API_TOKEN = "Ab123456";
const CONFIGURED = !SHEET_API_URL.includes("PASTE_YOUR") && !SHEET_API_TOKEN.includes("PASTE_YOUR");

async function sheetGet(key){
  const url = `${SHEET_API_URL}?action=get&key=${encodeURIComponent(key)}&token=${encodeURIComponent(SHEET_API_TOKEN)}`;
  const res = await fetch(url);
  const data = await res.json();
  if(data.error) throw new Error(data.error);
  return data.found ? data.value : null;
}

async function sheetGetAll(prefix){
  const url = `${SHEET_API_URL}?action=getAll&prefix=${encodeURIComponent(prefix)}&token=${encodeURIComponent(SHEET_API_TOKEN)}`;
  const res = await fetch(url);
  const data = await res.json();
  if(data.error) throw new Error(data.error);
  return data.data; // { "room:1/1": "...json...", ... }
}

async function sheetSet(key, value){
  const res = await fetch(SHEET_API_URL, {
    method:'POST',
    headers:{'Content-Type':'text/plain;charset=utf-8'},
    body: JSON.stringify({ action:'set', key, value, token: SHEET_API_TOKEN })
  });
  const data = await res.json();
  if(data.error) throw new Error(data.error);
  return data.ok;
}

const storageWorks = CONFIGURED;
let loadErrorRooms = new Set();     // ห้องที่ดึงข้อมูลไม่สำเร็จจริงๆ (ไม่ใช่แค่ยังไม่เคยมีข้อมูล)
let lastSyncAt = null;

async function fetchRoomOnce(id){
  // คืนค่า: {ok:true, data} หรือ {ok:false, missing:true} หรือ {ok:false, missing:false}
  try{
    const raw = await sheetGet(`room:${id}`);
    if(raw===null) return { ok:false, missing:true };
    return { ok:true, data: JSON.parse(raw) };
  }catch(e){
    return { ok:false, missing:false, err:e };
  }
}

async function loadAllRooms(){
  loadErrorRooms = new Set();
  if(!storageWorks){
    ROOMS.forEach(r=>{ roomData[r.id] = defaultRoomRecord(r); });
    return;
  }
  let map = null;
  try{
    map = await sheetGetAll('room:');
  }catch(e){
    try{
      await new Promise(res=>setTimeout(res, 500));
      map = await sheetGetAll('room:');
    }catch(e2){
      map = null;
    }
  }
  if(map){
    ROOMS.forEach(r=>{
      const raw = map[`room:${r.id}`];
      if(raw){
        try{ roomData[r.id] = JSON.parse(raw); }
        catch(parseErr){ if(!roomData[r.id]) roomData[r.id] = defaultRoomRecord(r); loadErrorRooms.add(r.id); }
      } else {
        roomData[r.id] = defaultRoomRecord(r);
      }
    });
  } else {
    // ดึงข้อมูลรวมล้มเหลวทั้งชุด — คงค่าที่มีอยู่ในเครื่องไว้ (ถ้ามี) อย่าเสี่ยงทับด้วยค่าว่าง
    ROOMS.forEach(r=>{
      if(!roomData[r.id]) roomData[r.id] = defaultRoomRecord(r);
      loadErrorRooms.add(r.id);
    });
  }
  lastSyncAt = new Date();
}

async function saveRoom(id){
  if(!storageWorks){
    showToast('ยังไม่ได้เชื่อมต่อ Google Sheets — ข้อมูลจะไม่ถูกบันทึกถาวร');
    return false;
  }
  try{
    await sheetSet(`room:${id}`, JSON.stringify(roomData[id]));
    loadErrorRooms.delete(id);
    showToast(`บันทึกห้อง ${id} เรียบร้อย`);
    return true;
  }catch(e){
    alert(`บันทึกข้อมูลห้อง ${id} ไม่สำเร็จ (${e.message||e}) กรุณาลองใหม่อีกครั้ง (อย่าเพิ่งปิดหน้าต่างนี้)`);
    return false;
  }
}

// รีเฟรชข้อมูลล่าสุดจากทีม (เผื่อคนอื่นเพิ่งบันทึก) ก่อนเปิดห้อง
async function refreshRoom(id){
  if(!storageWorks) return;
  const result = await fetchRoomOnce(id);
  if(result.ok && result.data){ roomData[id] = result.data; loadErrorRooms.delete(id); }
  else if(!result.ok && !result.missing) loadErrorRooms.add(id);
}

function showToast(msg){
  let t = document.getElementById('toastEl');
  if(!t){ t = document.createElement('div'); t.id='toastEl'; t.className='toast'; document.body.appendChild(t); }
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(showToast._tm);
  showToast._tm = setTimeout(()=> t.classList.remove('show'), 2200);
}

function renderBanner(){
  const el = document.getElementById('banner');
  if(!storageWorks){
    el.innerHTML = `<div class="banner-msg error">⚠ ยังไม่ได้เชื่อมต่อ Google Sheets — แก้ค่า SHEET_API_URL และ SHEET_API_TOKEN ที่ต้นไฟล์ก่อน ไม่งั้นข้อมูลจะหายเมื่อปิดหน้าเว็บ</div>`;
  } else if(loadErrorRooms.size>0){
    el.innerHTML = `<div class="banner-msg error">⚠ ดึงข้อมูลห้อง ${[...loadErrorRooms].join(', ')} ไม่สำเร็จ — ห้ามบันทึกทับห้องเหล่านี้จนกว่าจะกด "↻ รีเฟรช" สำเร็จ</div>`;
  } else {
    el.innerHTML = '';
  }
}

/* ============================= UTIL ============================= */
function monthKey(d){ return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`; }
function monthLabel(key){ const [y,m]=key.split('-'); return `${THAI_MONTHS[parseInt(m,10)-1]} ${parseInt(y,10)+543}`; }
function todayStr(){ return new Date().toISOString().slice(0,10); }
function fmtDate(s){
  if(!s) return '—';
  const d = new Date(s+'T00:00:00');
  return `${d.getDate()} ${THAI_MONTHS[d.getMonth()].slice(0,3)} ${d.getFullYear()+543}`;
}
function fmtMoney(n){ return Number(n||0).toLocaleString('th-TH',{minimumFractionDigits:0,maximumFractionDigits:2}); }
function daysUntil(dateStr){
  if(!dateStr) return null;
  const t = new Date(); t.setHours(0,0,0,0);
  const d = new Date(dateStr+'T00:00:00');
  return Math.round((d-t)/86400000);
}
function addMonths(dateStr, n){
  const d = new Date(dateStr+'T00:00:00');
  d.setMonth(d.getMonth()+n);
  return d.toISOString().slice(0,10);
}
function escapeHtml(s){
  return String(s ?? '').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
// ใช้ราคาจริงที่บันทึกไว้ของห้องนั้นๆ (เผื่อมีการแก้ราคาทีหลัง) ไม่ใช่ราคาตั้งต้น
function currentPrice(id){
  return (roomData[id] && roomData[id].price!=null) ? roomData[id].price : (ROOMS.find(x=>x.id===id)||{}).price || 0;
}
function billTotal(id, bill){
  const price = currentPrice(id);
  if(!bill) return price;
  const fees = (bill.otherFees||[]).reduce((s,f)=>s+(Number(f.amt)||0),0);
  return price + (Number(bill.heads)||0)*WATER_RATE + (Number(bill.elecUnits)||0)*ELEC_RATE + fees;
}
function getBill(id, mKey){
  const rec = roomData[id];
  return rec.bills[mKey] || null;
}
function ensureBill(id, mKey){
  const rec = roomData[id];
  if(!rec.bills[mKey]){
    rec.bills[mKey] = { heads: rec.defaultHeads||1, elecUnits:0, otherFees:[], paid:false, paidDate:null };
  }
  return rec.bills[mKey];
}

/* ============================= RENDER: SHELL ============================= */
function switchView(v){
  currentView = v;
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.toggle('active', b.dataset.view===v));
  render();
}
document.querySelectorAll('.tab-btn').forEach(b=> b.addEventListener('click', ()=>switchView(b.dataset.view)) );

function render(){
  renderBanner();
  const app = document.getElementById('app');
  app.innerHTML = currentView==='dashboard' ? dashboardHTML() : roomsHTML();
  bindViewEvents();
}

