/* ============================= DASHBOARD ============================= */
function dashboardHTML(){
  const mKey = monthKey(viewMonth);
  const rentable = ROOMS.filter(r=>r.rentable);
  const occupied = rentable.filter(r=>roomData[r.id].tenantName.trim()!=='');
  const vacant = rentable.filter(r=>roomData[r.id].tenantName.trim()==='');

  let expectedTotal = 0, collectedTotal = 0, unpaidCount = 0;
  occupied.forEach(r=>{
    const bill = getBill(r.id, mKey);
    const tot = billTotal(r.id, bill);
    expectedTotal += tot;
    if(bill && bill.paid) collectedTotal += tot; else unpaidCount++;
  });

  // contract alerts
  const alerts = [];
  rentable.forEach(r=>{
    const rec = roomData[r.id];
    if(!rec.contractEnd) return;
    const dLeft = daysUntil(rec.contractEnd);
    if(dLeft < 0) alerts.push({room:r.id, type:'over', text:`สัญญาห้อง ${r.id} หมดอายุแล้ว ${Math.abs(dLeft)} วัน (ผู้เช่า: ${escapeHtml(rec.tenantName)||'—'})`});
    else if(dLeft <= 14) alerts.push({room:r.id, type:'soon', text:`สัญญาห้อง ${r.id} จะครบกำหนดในอีก ${dLeft} วัน (${fmtDate(rec.contractEnd)}) — เตรียมต่อสัญญาใหม่ทุก ${RENEW_MONTHS} เดือน`});
  });

  const unpaidRooms = occupied.filter(r=>{ const b=getBill(r.id,mKey); return !b || !b.paid; });

  return `
    <h2 class="section-title">ภาพรวมประจำเดือน</h2>
    <p class="section-sub">สรุปรายรับและสถานะห้องพัก เลือกเดือนที่ต้องการดูได้ด้านล่าง</p>
    ${monthPickerHTML()}

    <div class="stat-grid">
      <div class="stat-card accent"><div class="num">${occupied.length}/${rentable.length}</div><div class="lbl">ห้องมีผู้เช่า</div></div>
      <div class="stat-card"><div class="num">${vacant.length}</div><div class="lbl">ห้องว่าง</div></div>
      <div class="stat-card"><div class="num">฿${fmtMoney(expectedTotal)}</div><div class="lbl">รายรับที่คาดไว้เดือนนี้</div></div>
      <div class="stat-card"><div class="num">฿${fmtMoney(collectedTotal)}</div><div class="lbl">เก็บได้แล้ว</div></div>
      <div class="stat-card warn"><div class="num">${unpaidCount}</div><div class="lbl">ห้องยังไม่จ่าย</div></div>
    </div>

    <h3 class="section-title" style="font-size:16px;">แจ้งเตือนสัญญาเช่า</h3>
    <div class="alert-list">
      ${alerts.length ? alerts.sort((a,b)=> a.type==='over'?-1:1).map(a=>`
        <div class="alert-item ${a.type==='soon'?'soft':''}">
          <span>${a.text}</span>
          <button data-open="${a.room}">จัดการ</button>
        </div>`).join('') : `<div class="empty-note">ไม่มีสัญญาที่ใกล้ครบกำหนดในช่วงนี้</div>`}
    </div>

    <h3 class="section-title" style="font-size:16px;">ห้องที่ยังไม่ชำระ — ${monthLabel(mKey)}</h3>
    <div class="alert-list">
      ${unpaidRooms.length ? unpaidRooms.map(r=>`
        <div class="alert-item">
          <span><b>${r.id}</b> — ${escapeHtml(roomData[r.id].tenantName) || 'ไม่ระบุชื่อผู้เช่า'} · ค่าเช่ารวมประมาณ ฿${fmtMoney(billTotal(r.id, getBill(r.id,mKey)))}</span>
          <button data-open="${r.id}">จัดการ</button>
        </div>`).join('') : `<div class="empty-note">ห้องที่มีผู้เช่าทั้งหมดชำระแล้วในเดือนนี้</div>`}
    </div>
  `;
}

/* ============================= ROOMS LIST ============================= */
function roomsHTML(){
  const mKey = monthKey(viewMonth);
  const buildings = [...new Set(ROOMS.map(r=>r.building))];

  let list = ROOMS.filter(r=>{
    if(searchTerm){
      const rec = roomData[r.id];
      const hay = (r.id+' '+rec.tenantName).toLowerCase();
      if(!hay.includes(searchTerm.toLowerCase())) return false;
    }
    if(roomFilter==='occupied') return r.rentable && roomData[r.id].tenantName.trim()!=='';
    if(roomFilter==='vacant') return r.rentable && roomData[r.id].tenantName.trim()==='';
    if(roomFilter==='unpaid'){ if(!r.rentable) return false; const b=getBill(r.id,mKey); return roomData[r.id].tenantName.trim()!=='' && (!b||!b.paid); }
    return true;
  });

  const blocks = buildings.map(b=>{
    const rooms = list.filter(r=>r.building===b);
    if(!rooms.length) return '';
    return `
      <div class="building-block">
        <div class="building-head"><h3>${b}</h3><span>${rooms.length} ห้อง</span></div>
        <div class="room-grid">
          ${rooms.map(r=>roomCardHTML(r, mKey)).join('')}
        </div>
      </div>`;
  }).join('');

  return `
    <h2 class="section-title">ห้องพักทั้งหมด</h2>
    <p class="section-sub">คลิกที่ห้องเพื่อดูรายละเอียด บันทึกบิล สัญญา และประวัติซ่อมบำรุง</p>
    ${monthPickerHTML()}
    <div class="filter-row">
      <button class="fbtn ${roomFilter==='all'?'active':''}" data-f="all">ทั้งหมด</button>
      <button class="fbtn ${roomFilter==='occupied'?'active':''}" data-f="occupied">มีผู้เช่า</button>
      <button class="fbtn ${roomFilter==='vacant'?'active':''}" data-f="vacant">ห้องว่าง</button>
      <button class="fbtn ${roomFilter==='unpaid'?'active':''}" data-f="unpaid">ยังไม่จ่าย (เดือนนี้)</button>
      <input class="searchbox" id="searchBox" placeholder="ค้นหาห้อง / ชื่อผู้เช่า" value="${escapeHtml(searchTerm)}">
    </div>
    ${blocks || `<div class="empty-note">ไม่พบห้องที่ตรงกับเงื่อนไข</div>`}
  `;
}

function roomCardHTML(r, mKey){
  const rec = roomData[r.id];
  const occupied = rec.tenantName.trim()!=='';
  const bill = getBill(r.id, mKey);
  const dLeft = rec.contractEnd ? daysUntil(rec.contractEnd) : null;

  let badges = '';
  if(!r.rentable){
    badges += `<span class="badge" style="background:#eee;color:#888;">ไม่ปล่อยเช่า</span>`;
  } else if(occupied){
    badges += bill && bill.paid ? `<span class="badge paid">จ่ายแล้ว</span>` : `<span class="badge unpaid">ยังไม่จ่าย</span>`;
    if(dLeft!==null){
      if(dLeft<0) badges += `<span class="badge exp-over">สัญญาหมดอายุ</span>`;
      else if(dLeft<=14) badges += `<span class="badge exp-soon">ใกล้ครบสัญญา</span>`;
    }
  }
  if(r.ac) badges += `<span class="badge ac">แอร์</span>`;

  return `
    <div class="room-card ${occupied?'':'vacant'}" data-open="${r.id}">
      <div class="rid">${r.id}</div>
      <div class="price">${r.rentable? '฿'+fmtMoney(currentPrice(r.id))+' / เดือน' : 'ไม่ให้เช่า'}</div>
      <div class="tenant ${occupied?'':'muted'}">${occupied ? escapeHtml(rec.tenantName) : 'ห้องว่าง'}</div>
      <div>${badges}</div>
    </div>`;
}

function bindViewEvents(){
  const mPrev = document.getElementById('mPrev'); if(mPrev) bindMonthPicker();
  document.querySelectorAll('[data-open]').forEach(el=>{
    el.addEventListener('click', (e)=>{ e.stopPropagation(); openModal(el.dataset.open); });
  });
  document.querySelectorAll('[data-f]').forEach(el=>{
    el.addEventListener('click', ()=>{ roomFilter = el.dataset.f; render(); });
  });
  const sb = document.getElementById('searchBox');
  if(sb) sb.addEventListener('input', ()=>{ searchTerm = sb.value; render(); });
}

/* ============================= MODAL ============================= */
async function openModal(id){
  modalRoomId = id; modalTab = 'tenant';
  document.getElementById('overlay').classList.add('show');
  document.getElementById('modalBox').innerHTML = `<div class="loading">กำลังดึงข้อมูลล่าสุด…</div>`;
  await refreshRoom(id);
  renderModal();
}
function closeModal(){
  document.getElementById('overlay').classList.remove('show');
  modalRoomId = null;
  render();
}
document.getElementById('overlay').addEventListener('click', (e)=>{ if(e.target.id==='overlay') closeModal(); });

function renderModal(){
  const r = ROOMS.find(x=>x.id===modalRoomId);
  const rec = roomData[modalRoomId];
  const box = document.getElementById('modalBox');
  box.innerHTML = `
    <div class="modal-head">
      <div>
        <h2>ห้อง ${r.id}</h2>
        <div class="sub">${r.building} · ฿${fmtMoney(currentPrice(r.id))}/เดือน ${r.ac?'· ห้องแอร์':''}</div>
      </div>
      <button id="closeModal">✕</button>
    </div>
    <div class="modal-tabs">
      <button data-t="tenant" class="${modalTab==='tenant'?'active':''}">ผู้เช่า &amp; สัญญา</button>
      <button data-t="bill" class="${modalTab==='bill'?'active':''}">บิลรายเดือน</button>
      <button data-t="maint" class="${modalTab==='maint'?'active':''}">ประวัติซ่อมบำรุง</button>
    </div>
    <div class="modal-body" id="modalBody"></div>
  `;
  document.getElementById('closeModal').onclick = closeModal;
  box.querySelectorAll('.modal-tabs button').forEach(b=>{
    b.onclick = ()=>{ modalTab=b.dataset.t; renderModal(); };
  });
  const body = document.getElementById('modalBody');
  if(modalTab==='tenant') body.innerHTML = tenantTabHTML(r, rec);
  else if(modalTab==='bill') body.innerHTML = billTabHTML(r, rec);
  else body.innerHTML = maintTabHTML(rec);
  bindModalTabEvents(r, rec);
}

