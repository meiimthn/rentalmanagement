  const rent = currentPrice(modalRoomId);
  const water = (Number(bill.heads)||0)*WATER_RATE;
  const elec = (Number(bill.elecUnits)||0)*ELEC_RATE;
  const feesTotal = (bill.otherFees||[]).reduce((s,f)=>s+(Number(f.amt)||0),0);
  const total = rent+water+elec+feesTotal;

  const monthRows = Object.keys(rec.bills).sort().reverse().slice(0,12).map(k=>{
    const b = rec.bills[k];
    const t = billTotal(modalRoomId, b);
    return `<tr>
      <td>${monthLabel(k)}</td>
      <td>฿${fmtMoney(t)}</td>
      <td>${b.paid ? `<span class="badge paid">จ่ายแล้ว${b.paidDate? ' · '+fmtDate(b.paidDate):''}</span>` : `<span class="badge unpaid">ค้างชำระ</span>`}</td>
