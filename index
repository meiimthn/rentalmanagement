        <div class="c">${escapeHtml(m.desc)}</div>
        ${m.cost ? `<div class="cost">ค่าใช้จ่าย ฿${fmtMoney(m.cost)}</div>` : ''}
      </div>`).join('') : `<div class="empty-note">ยังไม่มีประวัติซ่อมบำรุงสำหรับห้องนี้</div>`}
  `;
}

/* ---- bind interactions inside modal ---- */
function bindModalTabEvents(r, rec){
  if(modalTab==='tenant'){
    document.getElementById('renewBtn').onclick = ()=>{
      const startEl = document.getElementById('fStart');
      const endEl = document.getElementById('fEnd');
      const base = endEl.value || startEl.value || todayStr();
      const newStart = base;
      const newEnd = addMonths(base, RENEW_MONTHS);
      startEl.value = newStart; endEl.value = newEnd;
    };
    document.getElementById('saveTenant').onclick = async ()=>{
      rec.tenantName = document.getElementById('fTenant').value.trim();
      rec.phone = document.getElementById('fPhone').value.trim();
      rec.price = Number(document.getElementById('fPrice').value)||0;
      rec.defaultHeads = Number(document.getElementById('fHeads').value)||0;
      rec.contractStart = document.getElementById('fStart').value;
      rec.contractEnd = document.getElementById('fEnd').value;
      await saveRoom(modalRoomId);
      renderModal();
    };
  }
  if(modalTab==='bill'){
    document.getElementById('addFee').onclick = ()=>{
      const mKey = monthKey(viewMonth);
      const bill = ensureBill(modalRoomId, mKey);
      bill.otherFees = bill.otherFees||[];
      bill.otherFees.push({desc:'',amt:0});
      renderModal();
    };
    document.querySelectorAll('[data-rmfee]').forEach(btn=>{
      btn.onclick = ()=>{
        const mKey = monthKey(viewMonth);
        const bill = ensureBill(modalRoomId, mKey);
        bill.otherFees.splice(Number(btn.dataset.rmfee),1);
        renderModal();
      };
    });
    document.querySelectorAll('[data-gomonth]').forEach(btn=>{
      btn.onclick = ()=>{
        const [y,m] = btn.dataset.gomonth.split('-');
        viewMonth = new Date(Number(y), Number(m)-1, 1);
        renderModal();
      };
    });
    document.getElementById('saveBill').onclick = async ()=>{
      const mKey = monthKey(viewMonth);
      const bill = ensureBill(modalRoomId, mKey);
      bill.heads = Number(document.getElementById('bHeads').value)||0;
      bill.elecUnits = Number(document.getElementById('bElec').value)||0;
      const descs = document.querySelectorAll('#feeList .fdesc');
      const amts = document.querySelectorAll('#feeList .famt');
      bill.otherFees = Array.from(descs).map((d,i)=>({desc:d.value, amt:Number(amts[i].value)||0}));
      const wasPaid = bill.paid;
      bill.paid = document.getElementById('bPaid').checked;
      if(bill.paid && !wasPaid) bill.paidDate = todayStr();
      if(!bill.paid) bill.paidDate = null;
      await saveRoom(modalRoomId);
      renderModal();
    };
  }
  if(modalTab==='maint'){
    document.getElementById('addMaint').onclick = async ()=>{
      const date = document.getElementById('mDate').value || todayStr();
      const desc = document.getElementById('mDesc').value.trim();
      const cost = Number(document.getElementById('mCost').value)||0;
      if(!desc){ alert('กรุณาระบุรายละเอียดงานซ่อม'); return; }
      rec.maintenance.push({date, desc, cost});
      await saveRoom(modalRoomId);
      renderModal();
    };
  }
}

/* ============================= BACKUP / RESTORE ============================= */
function downloadBackup(){
  const payload = { exportedAt: new Date().toISOString(), rooms: roomData };
  const blob = new Blob([JSON.stringify(payload, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const d = new Date();
  a.href = url;
  a.download = `rental-backup-${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}.json`;
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
  showToast('ดาวน์โหลดไฟล์สำรองข้อมูลแล้ว');
}

async function restoreFromFile(file){
  let parsed;
  try{
    const text = await file.text();
    parsed = JSON.parse(text);
  }catch(e){
    alert('ไฟล์นี้ไม่ใช่ไฟล์สำรองข้อมูลที่ถูกต้อง');
    return;
  }
  if(!parsed || typeof parsed.rooms !== 'object'){
    alert('รูปแบบไฟล์ไม่ถูกต้อง');
    return;
  }
  const ids = Object.keys(parsed.rooms).filter(id => ROOMS.some(r=>r.id===id));
  if(!ids.length){ alert('ไม่พบข้อมูลห้องที่ตรงกับระบบนี้ในไฟล์'); return; }
  const ok = confirm(`ไฟล์นี้มีข้อมูล ${ids.length} ห้อง (สำรองเมื่อ ${parsed.exportedAt ? fmtDate(parsed.exportedAt.slice(0,10)) : 'ไม่ทราบวันที่'})\n\nการกู้คืนจะเขียนทับข้อมูลปัจจุบันของห้องเหล่านี้ทั้งหมด ยืนยันหรือไม่?`);
  if(!ok) return;
  for(const id of ids){
    roomData[id] = parsed.rooms[id];
    await saveRoom(id);
  }
  showToast('กู้คืนข้อมูลเรียบร้อยแล้ว');
  render();
}

/* ============================= INIT ============================= */
document.getElementById('refreshBtn').addEventListener('click', async ()=>{
  showToast('กำลังดึงข้อมูลล่าสุด…');
  await loadAllRooms();
  if(modalRoomId) await refreshRoom(modalRoomId);
  render();
  if(modalRoomId) renderModal();
  showToast('ข้อมูลล่าสุดแล้ว');
});
document.getElementById('backupBtn').addEventListener('click', downloadBackup);
document.getElementById('restoreBtn').addEventListener('click', ()=> document.getElementById('restoreFile').click());
document.getElementById('restoreFile').addEventListener('change', (e)=>{
  const f = e.target.files[0];
  if(f) restoreFromFile(f);
  e.target.value = '';
});

(async function init(){
  await loadAllRooms();
  render();
  // ดึงข้อมูลล่าสุดจากทีมทุก 60 วินาที เฉพาะตอนไม่มีหน้าต่างแก้ไขเปิดอยู่ (กันข้อมูลตีกัน)
  if(storageWorks){
    setInterval(async ()=>{
      if(!modalRoomId){ await loadAllRooms(); render(); }
    }, 60000);
  }
})();
</script>
